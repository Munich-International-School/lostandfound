rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff are the email/password accounts added in Firebase Authentication with a
    // school address. Public sign-up is disabled, so only accounts created in the
    // console can sign in. The domain must match STAFF_DOMAIN in js/firebase-config.js.
    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "password"
        && request.auth.token.email.lower().matches(".*@mis-munich[.]de");
    }

    function claimPath(itemId) {
      return /databases/$(database)/documents/claims/$(itemId);
    }

    function itemPath(itemId) {
      return /databases/$(database)/documents/items/$(itemId);
    }

    function validItem(d) {
      return d.keys().hasOnly(["type", "brand", "color", "size", "location", "notes", "photo", "claimed", "added"])
        && d.type is string && d.type.size() > 0 && d.type.size() <= 40
        && d.brand is string && d.brand.size() <= 100
        && d.color is string && d.color.size() <= 100
        && d.size is string && d.size.size() <= 40
        && d.location is string && d.location.size() <= 100
        && d.notes is string && d.notes.size() <= 1000
        && d.photo is string && d.photo.size() <= 900000
        && d.claimed == false
        && d.added is int;
    }

    function onlyClaimedChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["claimed"]);
    }

    // Anyone: mark an unclaimed item claimed in the same batch that creates its claim record.
    function isClaim(itemId) {
      return resource.data.claimed == false
        && request.resource.data.claimed == true
        && onlyClaimedChanges()
        && !exists(claimPath(itemId))
        && existsAfter(claimPath(itemId));
    }

    // Staff: mark a claimed item available in the same batch that deletes its claim record.
    function isUnclaim(itemId) {
      return isStaff()
        && resource.data.claimed == true
        && request.resource.data.claimed == false
        && onlyClaimedChanges()
        && !existsAfter(claimPath(itemId));
    }

    // Everyone can browse items. Only staff can add or delete them. `claimed` and the
    // claims/ record always change together, so they can't get out of step.
    match /items/{itemId} {
      allow read: if true;
      allow create: if isStaff() && validItem(request.resource.data);
      allow update: if isClaim(itemId) || isUnclaim(itemId);
      // The claim record goes with the item, so no student name is left behind.
      allow delete: if isStaff() && !existsAfter(claimPath(itemId));
    }

    // Student names and classes are kept apart from items so only staff can read them.
    match /claims/{itemId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(["claimedBy", "claimedClass"])
        && request.resource.data.claimedBy is string
        && request.resource.data.claimedBy.size() > 0
        && request.resource.data.claimedBy.size() <= 100
        && request.resource.data.claimedClass is string
        && request.resource.data.claimedClass.matches("^([1-9]|1[0-2])[A-F]$")
        && get(itemPath(itemId)).data.claimed == false
        && getAfter(itemPath(itemId)).data.claimed == true;
      // Only as part of unclaiming or deleting the item.
      allow delete: if isStaff()
        && (!existsAfter(itemPath(itemId)) || getAfter(itemPath(itemId)).data.claimed == false);
    }
  }
}
